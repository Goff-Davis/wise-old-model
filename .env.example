# Copy this file to .env and fill in CONTACT. .env is git-ignored.

# Required. Your Discord name or email, sent in the User-Agent so Wise Old Man, Temple and the wiki can reach you.
CONTACT=

# Port the server listens on (on 127.0.0.1 only).
PORT=4747

# Database, backups, icons and the AI's working folder. Empty means your OS's app-data folder.
# Folder settings accept ~ for your home folder.
DATA_DIR=

# Where RuneLite keeps Character Export's files. Empty means ~/.runelite.
# On WSL with RuneLite on Windows: /mnt/c/Users/<you>/.runelite (this also works when the app runs on Windows).
RUNELITE_DIR=

# Claude only: used when Claude's billing is set to API key in Settings.
ANTHROPIC_API_KEY=

# Other AIs for the chat (Claude is always there). Set up any, then pick one in Settings → AI.
# See README.md → Choosing the AI for examples.

# An OpenAI-compatible API: OpenAI (https://api.openai.com/v1), OpenRouter
# (https://openrouter.ai/api/v1), Ollama (http://localhost:11434/v1), LM Studio
# (http://localhost:1234/v1), Groq, Mistral... Empty turns it off.
OPENAI_COMPAT_BASE_URL=
# Its key; a local server needs none.
OPENAI_COMPAT_API_KEY=
# What the app calls it, such as OpenRouter. Empty means OpenAI-compatible.
OPENAI_COMPAT_NAME=
# The model it answers with until one is picked in Settings. Empty means the first of its models by name.
OPENAI_COMPAT_MODEL=

# Gemini: a key from Google AI Studio. Empty turns it off.
GEMINI_API_KEY=
# The model it answers with until one is picked in Settings. Empty means the first it lists that thinks.
GEMINI_MODEL=
