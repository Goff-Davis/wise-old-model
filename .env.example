# Copy this file to .env and fill in CONTACT. .env is git-ignored.

# Required. Your Discord name or email, sent in the User-Agent so Wise Old Man, Temple and the wiki can reach you.
CONTACT=

# Port the server listens on (on 127.0.0.1 only).
PORT=4747

# Database, backups, icons and the AI's working folder. Empty means your OS's app-data folder.
# Folder settings accept ~ for your home folder.
DATA_DIR=

# Where RuneLite keeps Character Export's files. Empty means ~/.runelite.
# On WSL with RuneLite on Windows: /mnt/c/Users/<you>/.runelite (this also works when the app runs on Windows).
RUNELITE_DIR=

# Only used when the chat's billing is set to API key in Settings.
ANTHROPIC_API_KEY=
